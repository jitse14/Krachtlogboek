# Kopieer dit bestand naar .env om lokaal een andere database te gebruiken,
# bijvoorbeeld een testproject in Supabase. .env staat niet in git.
# Zonder .env gebruikt de app de echte database.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://jouw-testproject.supabase.co
# Supabase → Project Settings → API Keys → Publishable key
SUPABASE_KEY=sb_publishable_...
